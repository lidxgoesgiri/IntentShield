# ---------------------------------------------------------------------------
# IntentShield environment template — placeholders only, never real secrets.
# Copy to .env.local for local development. Production values are set in the
# hosting provider's environment settings (e.g. Vercel), never committed.
# ---------------------------------------------------------------------------

# Public / browser-safe. Devnet only — the app refuses any other cluster and
# verifies the RPC genesis hash at runtime (fail closed on mismatch).
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public links shown on the landing page. An empty docs URL uses the
# configured repository README. An empty repository URL hides its link.
NEXT_PUBLIC_REPOSITORY_URL=https://github.com/lidxgoesgiri/IntentShield
NEXT_PUBLIC_DOCS_URL=
# Optional override for the documented historical Devnet proof signature.
# Empty uses src/config/proof.ts. The receipt page re-checks on-chain status;
# the landing link alone is not evidence of current confirmation.
NEXT_PUBLIC_PROOF_SIGNATURE=

# Server-only AI configuration — NEVER prefix with NEXT_PUBLIC_.
# Without a key the AI endpoints answer 503 AI_UNAVAILABLE and the app falls
# back to manual entry; all security checks still run.
OPENROUTER_API_KEY=
# Default model (provider/model[:variant]). May also be a comma-separated list;
# its first entry is the default.
OPENROUTER_MODEL=
# Optional extra models the workspace may switch to (comma-separated). Together
# with OPENROUTER_MODEL this is the server-side allowlist; any other model id
# sent by a browser is rejected with 400. Example:
# OPENROUTER_MODELS=provider/model-a,provider/model-b:free
OPENROUTER_MODELS=
# Optional override for an OpenAI-compatible endpoint (default OpenRouter).
AI_BASE_URL=https://openrouter.ai/api/v1

# Optional server abuse protection (best effort, shared per process across AI
# routes). These counters are NOT a global cap across serverless instances.
# Set an independent provider/key spending limit for a global cost boundary.
AI_REQUESTS_PER_MINUTE=10
AI_DAILY_REQUEST_BUDGET=500
